APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_BUSY_TIMEOUT=5000
# DB_JOURNAL_MODE=WAL
# DB_SYNCHRONOUS=NORMAL
# DB_TRANSACTION_MODE=IMMEDIATE
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
OPERATIONS_CACHE_STORE=file
QUEUE_DRAIN_MAX_TIME=50
QUEUE_DRAIN_MEMORY=128
QUEUE_JOB_TIMEOUT=600
SCHEDULER_STALE_SECONDS=150
QUEUE_STALE_SECONDS=750
FAST_TRACKER_STALE_SECONDS=75
SOLANA_TOKEN_METADATA_CACHE_SECONDS=86400
SOLANA_OPPORTUNITY_MAX_AGE_SECONDS=300
SOLANA_TRANSACTION_VALIDATOR_NODE=node
SOLANA_TRANSACTION_VALIDATOR_TIMEOUT_SECONDS=5

PAPER_TRADE_SIZE_SOL=0.10
PAPER_TRADE_SIZE_ETH=0.10
PAPER_STARTING_BALANCE_SOL=5
PAPER_STARTING_BALANCE_ETH=5
PAPER_TRACKER_INTERVAL_MS=1000
PAPER_TRACKER_SNAPSHOT_SECONDS=10
PAPER_TRACKER_LOCK_SECONDS=300
PAPER_TRACKER_STALE_SECONDS=5
PAPER_TRACKER_RATE_LIMIT_BACKOFF_MS=5000
PAPER_TRACKER_CACHE_STORE=file
PAPER_TRACKER_PERSIST_SECONDS=5
SQLITE_LOCK_RETRIES=3
SQLITE_LOCK_BACKOFF_MS=50

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
COINGECKO_MAX_PRICE_AGE_SECONDS=120
ETHEREUM_RPC_URL=
ZERO_X_BASE_URL=https://api.0x.org
ZERO_X_API_KEY=
JUPITER_BASE_URL=https://api.jup.ag/swap/v1
JUPITER_API_KEY=

SOLANA_TRANSACTION_VALIDATOR_DRIVER=http
SOLANA_TRANSACTION_VALIDATOR_URL=
SOLANA_TRANSACTION_VALIDATOR_API_KEY=
SOLANA_TRANSACTION_VALIDATOR_TIMEOUT_SECONDS=5

JUPITER_SWAP_V2_BASE_URL=https://api.jup.ag/swap/v2

# Non-trading TypeScript engine integration. Keep disabled until explicitly configured.
TRADING_ENGINE_ENABLED=false
TRADING_ENGINE_OPPORTUNITY_EXPORT_ENABLED=false
TRADING_ENGINE_OPPORTUNITY_PROJECTION_ENABLED=false
TRADING_ENGINE_EVALUATION_CONSUMPTION_ENABLED=false
TRADING_ENGINE_DECISION_BOUNDARY_ENABLED=false
TRADING_ENGINE_PAPER_DECISION_INTEGRATION_ENABLED=false
TRADING_ENGINE_PAPER_LIFECYCLE_INTEGRATION_ENABLED=false
TRADING_ENGINE_PAPER_LIFECYCLE_AUTHORITATIVE_ENABLED=false
# Enroll every otherwise eligible newly created Solana PAPER position. Keep false for canary-only rollout.
TRADING_ENGINE_PAPER_LIFECYCLE_GENERAL_ROLLOUT_ENABLED=false
# Comma-separated Laravel user IDs allowed when general rollout is disabled.
TRADING_ENGINE_PAPER_LIFECYCLE_CANARY_USER_IDS=
TRADING_ENGINE_LIVE_DECISION_INTEGRATION_ENABLED=false
TRADING_ENGINE_LIVE_PREPARATION_ENABLED=false
TRADING_ENGINE_LIVE_RECOVERY_ENABLED=false
TRADING_ENGINE_SOLANA_LIVE_INTEGRATION_ENABLED=false
TRADING_ENGINE_LIVE_ATTEMPT_ATTENTION_AFTER_SECONDS=900
TRADING_ENGINE_PROJECTION_RECOVERY_BATCH_SIZE=100
TRADING_ENGINE_PROJECTION_RECOVERY_STALE_AFTER_SECONDS=300
TRADING_ENGINE_PROJECTION_RECOVERY_LEASE_SECONDS=120
TRADING_ENGINE_BASE_URL=http://127.0.0.1:3100
TRADING_ENGINE_SERVICE_ISSUER=meme-scanner-laravel
TRADING_ENGINE_SERVICE_AUDIENCE=meme-scanner-trading-engine
TRADING_ENGINE_SERVICE_SUBJECT=meme-scanner-laravel
# Base64-encoded raw 64-byte Ed25519 secret key. Never commit a real key.
TRADING_ENGINE_PRIVATE_KEY_BASE64=
TRADING_ENGINE_ASSERTION_LIFETIME_SECONDS=30
TRADING_ENGINE_CONNECT_TIMEOUT_SECONDS=3
TRADING_ENGINE_TIMEOUT_SECONDS=8
# Shared HMAC secret for inbound engine events (minimum 32 bytes). Never commit a real secret.
TRADING_ENGINE_WEBHOOK_SECRET=
TRADING_ENGINE_WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=60
TRADING_ENGINE_WEBHOOK_BODY_MAX_BYTES=262144
TRADING_ENGINE_WEBHOOK_RATE_LIMIT_PER_MINUTE=600
