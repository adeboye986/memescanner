NODE_ENV=development
SERVICE_NAME=meme-scanner-trading-engine
SERVICE_VERSION=0.1.0
HOST=0.0.0.0
PORT=3100
LOG_LEVEL=info
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none

DATABASE_URL=postgresql://trading_engine:local_only_change_me@127.0.0.1:5433/trading_engine
DATABASE_MAX_CONNECTIONS=10
DATABASE_SSL=false
# Production databases using a private/custom CA should provide the Base64-encoded PEM certificate.
DATABASE_CA_CERT_BASE64=

REDIS_URL=redis://127.0.0.1:6380
REDIS_PREFIX=meme-scanner:engine:local

SERVICE_AUTH_ISSUER=meme-scanner-laravel
SERVICE_AUTH_AUDIENCE=meme-scanner-trading-engine
SERVICE_AUTH_PUBLIC_KEY_BASE64=replace_with_base64_encoded_ed25519_spki_der
SERVICE_AUTH_MAX_TOKEN_AGE_SECONDS=60
SERVICE_AUTH_CLOCK_TOLERANCE_SECONDS=5

LARAVEL_WEBHOOK_URL=http://127.0.0.1:4100/internal/trading-engine/events
LARAVEL_WEBHOOK_HMAC_SECRET=replace_with_at_least_32_random_bytes
LARAVEL_WEBHOOK_TIMEOUT_MS=5000

OUTBOX_BATCH_SIZE=25
OUTBOX_POLL_INTERVAL_MS=1000
WORKFLOW_IDLE_MAX_INTERVAL_MS=20000
OUTBOX_CLAIM_TTL_MS=30000
EVALUATION_BATCH_SIZE=25
EVALUATION_CLAIM_TTL_MS=30000
WORKFLOW_LEADER_RETRY_INTERVAL_MS=10000

# Engine financial PAPER entry is disabled until the Laravel cutover gate is explicitly enabled.
PAPER_ENTRY_ENABLED=false
# Fresh engine-owned PAPER portfolios start with this auditable SOL opening balance; no Laravel balance is imported.
PAPER_OPENING_BALANCE_NATIVE=5
PAPER_ENTRY_NOTIONAL_NATIVE=0.1
PAPER_ENTRY_INTENT_MAX_AGE_SECONDS=300
# Engine-owned PAPER observation and financial EXIT settlement remain disabled until cutover.
PAPER_FINANCIAL_LIFECYCLE_ENABLED=false
PAPER_OBSERVATION_MAX_AGE_SECONDS=120

# Phase 1 creates durable tasks, but no runtime starts the monitor while this remains false.
PAPER_MARKET_MONITORING_ENABLED=false
PAPER_MARKET_MONITOR_INTERVAL_MS=5000
PAPER_MARKET_MONITOR_BATCH_SIZE=30
PAPER_MARKET_PROVIDER_CONNECTION_TIMEOUT_MS=3000
PAPER_MARKET_PROVIDER_TIMEOUT_MS=8000
PAPER_MARKET_MONITOR_REQUEST_BUDGET=1
PAPER_MARKET_MONITOR_MAXIMUM_BACKOFF_MS=60000
PAPER_MARKET_MONITOR_LEASE_DURATION_MS=30000
SHUTDOWN_TIMEOUT_MS=15000
